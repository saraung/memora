# Copy to .env and fill in real values. Never commit .env.
APP_NAME=Memora
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# PostgreSQL connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://memora:change_me@localhost:5432/memora

# Auth (generate a strong random value for production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=memora

# Refresh-token cookie (set COOKIE_SECURE=true in production behind HTTPS)
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Frontend
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Password policy
PASSWORD_MIN_LENGTH=8

# One-time tokens
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# NOTE: rate limiting is deferred (PRD P0 follow-up). Add Redis + limiter
# configuration here when implemented.

# Cloudinary media storage. Copy the CLOUDINARY_URL format from the
# Dashboard → Settings → API Keys page and replace the key/secret.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://change-me:change-me@change-me
CLOUDINARY_FOLDER=memora

# Upload constraints (safe defaults, not secrets)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200
MEDIA_ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
MEDIA_ALLOWED_VIDEO_TYPES=["video/mp4","video/quicktime","video/webm"]
MEDIA_MAX_FILES_PER_POST=10

# Rate limiting (Redis-backed; in-memory fallback when unreachable)
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=10
RATE_LIMIT_SENSITIVE_PER_MIN=5
RATE_LIMIT_DEFAULT_PER_MIN=100

# Hardening
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MAX_BODY_BYTES=1048576
