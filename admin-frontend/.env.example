# Admin app environment.
# Leave VITE_API_BASE_URL unset in dev to use the /api proxy (see vite.config.ts).
# In production set it to the public API origin, e.g. https://api.memora.app/api/v1
VITE_API_BASE_URL=/api/v1

# Dev proxy target for the FastAPI backend.
VITE_PROXY_TARGET=http://localhost:8000
